# Placeholders only. Inject secrets from Azure Key Vault/deployment secret references.
# This is not a Compose override. See docs/production-azure.md.
NODE_ENV=production
PORT=3001
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_SERVER.postgres.database.azure.com:5432/REPLACE_DATABASE?sslmode=verify-full
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
ADMIN_APP_ORIGIN=https://admin.example.com
SESSION_COOKIE_NAME=north_orbital_session
SESSION_COOKIE_SECURE=true
SESSION_TTL_SECONDS=604800
LOCAL_HTTP_DEVELOPMENT=false
PUBLIC_CHAT_ALLOW_MISSING_ORIGIN=false
RATE_LIMIT_HASH_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET_FROM_KEY_VAULT
TRUST_PROXY_HOPS=0
METRICS_ENABLED=false
# Required before enabling metrics; restrict ingress to scrapers too.
# METRICS_TOKEN=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET_FROM_KEY_VAULT
PUBLIC_CHAT_RATE_LIMIT=30
PUBLIC_CHAT_RATE_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=900
UPLOAD_RATE_LIMIT=20
UPLOAD_RATE_WINDOW_SECONDS=3600
CHAT_RATE_LIMIT_MAX=30
LOG_LEVEL=info
OBJECT_STORAGE_ENDPOINT=https://s3.private.example.com
OBJECT_STORAGE_REGION=REPLACE_REGION
OBJECT_STORAGE_BUCKET=REPLACE_PRIVATE_BUCKET
OBJECT_STORAGE_ACCESS_KEY=REPLACE_FROM_KEY_VAULT
OBJECT_STORAGE_SECRET_KEY=REPLACE_FROM_KEY_VAULT
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_TIMEOUT_MS=120000
UPLOAD_MAX_BYTES=20971520
INGESTION_POLL_INTERVAL_MS=1000
INGESTION_MAX_ATTEMPTS=3
INGESTION_STALE_AFTER_MS=300000
INGESTION_EMBEDDING_CONCURRENCY=2
OCR_ENABLED=true
OCR_COMMAND=ocrmypdf
OCR_TIMEOUT_MS=180000
# Provision private AI compute before deployment. No cloud AI adapter is added by M27.
MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=https://ollama.private.example.com
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
MODEL_TIMEOUT_MS=30000
EMBEDDING_TIMEOUT_MS=60000
RAG_TOP_K=5
RAG_LEXICAL_CANDIDATES=30
RAG_VECTOR_CANDIDATES=30
RAG_VECTOR_WEIGHT=0.85
RAG_LEXICAL_WEIGHT=0.15
RAG_RRF_K=60
RAG_MAX_CONTEXT_CHARS=12000
RAG_QUERY_REWRITE_ENABLED=true

# M28 crawler: finite limits; exact-origin public HTTP(S) only.
CRAWLER_MAX_PAGES_PER_SOURCE=50
CRAWLER_MAX_DEPTH=3
CRAWLER_MAX_LINKS_PER_PAGE=100
# Uncompressed response, aggregate run and sitemap bytes; compressed responses rejected.
CRAWLER_MAX_RESPONSE_BYTES=1048576
CRAWLER_MAX_TOTAL_BYTES=20971520
CRAWLER_MAX_SITEMAP_BYTES=1048576
CRAWLER_MAX_SITEMAP_URLS=500
CRAWLER_MAX_SITEMAP_DOCUMENTS=10
CRAWLER_MAX_SITEMAP_DEPTH=2
CRAWLER_REQUEST_TIMEOUT_MS=10000
CRAWLER_TOTAL_TIMEOUT_MS=120000
CRAWLER_MAX_REDIRECTS=5
CRAWLER_MAX_ATTEMPTS=3
# One request at a time per source; delay between pages in milliseconds.
CRAWLER_REQUEST_DELAY_MS=100
CRAWLER_MAX_CHUNKS_PER_PAGE=30
CRAWLER_MAX_CHUNKS_PER_SOURCE=1500
CRAWLER_MAX_CHUNKS_PER_RUN=500
CRAWLER_USER_AGENT=NorthOrbitalKnowledgeCrawler/1.0
