{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run --exclude 'tests/integration/**'",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test:watch": "vitest --exclude 'tests/integration/**'",
    "documents:samples": "tsx src/documents/generate-samples.ts",
    "documents:extract": "tsx src/documents/build-corpus.ts",
    "documents:index": "npm run documents:extract && tsx src/documents/build-index.ts",
    "documents:search": "tsx src/documents/search-cli.ts",
    "documents:semantic": "tsx src/documents/build-semantic-index.ts",
    "documents:hybrid-index": "npm run documents:index && npm run documents:semantic",
    "documents:hybrid-search": "tsx src/documents/hybrid-search-cli.ts",
    "evaluate:hybrid": "node ../evaluation/run-hybrid-evaluation.mjs",
    "migrate": "node-pg-migrate",
    "test:db": "vitest run tests/integration",
    "worker": "node dist/ingestion/worker.js",
    "worker:dev": "tsx src/ingestion/worker.ts",
    "test:ocr": "npm run build && node scripts/verify-ocr.mjs",
    "evaluate:rag": "vitest run tests/production-rag.test.ts tests/integration/production-rag.test.ts",
    "auth:create-owner": "tsx src/security/create-owner.ts",
    "security:init": "node scripts/init-security.mjs",
    "backup:postgres": "node scripts/postgres-backup.mjs",
    "backup:verify": "node scripts/postgres-backup.mjs --verify",
    "backup:objects": "tsx src/operations/object-backup.ts",
    "restore:objects": "tsx src/operations/object-restore.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@prometheus-io/client": "^0.16.1",
    "argon2": "^0.45.1",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/yauzl": "^3.4.0",
    "docx": "^9.8.1",
    "node-pg-migrate": "^9.0.0",
    "pdf-lib": "^1.17.1",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
