# Backend
PORT=3001

# Model provider
MODEL_PROVIDER=ollama

# Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b

# Maximum time to wait for one model response
MODEL_TIMEOUT_MS=30000

# Basic chat request limiting
CHAT_RATE_LIMIT_MAX=30

# Local development database
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@localhost:55432/north_orbital
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
LOG_LEVEL=info

OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_TIMEOUT_MS=30000

# Production document ingestion (local development values only)
# Native backend/worker use localhost; Compose overrides endpoint to minio:9000.
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:59000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=north-orbital-documents
OBJECT_STORAGE_ACCESS_KEY=REPLACE_WITH_LOCAL_OR_DEPLOYMENT_ACCESS_KEY
OBJECT_STORAGE_SECRET_KEY=REPLACE_WITH_LOCAL_OR_DEPLOYMENT_SECRET_KEY
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_TIMEOUT_MS=120000
# For AWS S3 omit endpoint and both static credential keys to use IAM roles.
UPLOAD_MAX_BYTES=20971520
INGESTION_POLL_INTERVAL_MS=1000
INGESTION_MAX_ATTEMPTS=3
INGESTION_STALE_AFTER_MS=300000
INGESTION_EMBEDDING_CONCURRENCY=2
# The worker Docker image enables OCR; native development must install OCR first.
OCR_ENABLED=false
OCR_COMMAND=ocrmypdf
OCR_TIMEOUT_MS=180000

# Production PostgreSQL RAG (validated at startup; no local index required)
RAG_TOP_K=5
RAG_LEXICAL_CANDIDATES=30
RAG_VECTOR_CANDIDATES=30
RAG_VECTOR_WEIGHT=0.85
RAG_LEXICAL_WEIGHT=0.15
RAG_RRF_K=60
RAG_MAX_CONTEXT_CHARS=12000
RAG_QUERY_REWRITE_ENABLED=true

# Milestone 25 + 26 security. Generate independent random secrets, never commit values.
ADMIN_APP_ORIGIN=http://localhost:4200
SESSION_COOKIE_NAME=north_orbital_session
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=true
# Explicit local loopback HTTP only; production HTTPS keeps false/true above.
LOCAL_HTTP_DEVELOPMENT=false
PUBLIC_CHAT_ALLOW_MISSING_ORIGIN=false
PUBLIC_CHAT_RATE_LIMIT=30
PUBLIC_CHAT_RATE_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=900
UPLOAD_RATE_LIMIT=20
UPLOAD_RATE_WINDOW_SECONDS=3600
RATE_LIMIT_HASH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
TRUST_PROXY_HOPS=0
METRICS_ENABLED=false
# Set an independent random token before enabling metrics.
# METRICS_TOKEN=REPLACE_WITH_AN_INDEPENDENT_RANDOM_SECRET
